# Free Qwen inference on Groq (no paid GPU server required)
MANAGPT_PROVIDER=groq
MANAGPT_MODEL=qwen/qwen3.8-27b
MANAGPT_API_BASE_URL=https://api.groq.com/openai/v1
MANAGPT_API_KEY=
# OpenRouter alternative:
# MANAGPT_PROVIDER=openrouter
# MANAGPT_MODEL=qwen/qwen3.8-27b:free
# MANAGPT_API_BASE_URL=https://openrouter.ai/api/v1
# Local Ollama alternative:
# MANAGPT_PROVIDER=ollama
# MANAGPT_MODEL=qwen3.8:27b
# OLLAMA_HOST=http://127.0.0.1:11434
