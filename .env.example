# Local Python ManaGPT: load downloaded weights directly; no inference API needed.
MANAGPT_PROVIDER=local
MANAGPT_MODEL=huihui-ai/Huihui-Qwen3-Coder-Next-abliterated
MANAGPT_WEIGHTS_PATH=models/huihui-qwen3-coder-next
MANAGPT_MAX_NEW_TOKENS=1024

# Cloudflare Workers cannot execute 80B weights. Cloudflare deployments require
# a separate self-hosted GPU machine if using the public Workers web app.
