# Ollama is on your computer by default.
MANAGPT_MODEL=qwen3.8:27b
OLLAMA_HOST=http://127.0.0.1:11434
MANAGPT_DB=./managpt.db
MANAGPT_NUM_CTX=8192
MANAGPT_TEMPERATURE=0.7
# The web server binds only to localhost by default.
MANAGPT_WEB_HOST=127.0.0.1
MANAGPT_WEB_PORT=8000
# To override the default persona, put its text in this file:
# MANAGPT_SYSTEM_PROMPT_FILE=./my_persona.txt
