# Target: huihui-ai/Huihui-Qwen3-Coder-Next-abliterated (80B BF16; requires a capable model-serving endpoint).
MANAGPT_PROVIDER=openai-compatible
MANAGPT_MODEL=huihui-ai/Huihui-Qwen3-Coder-Next-abliterated
# OpenAI-compatible vLLM endpoint (HTTPS; include /v1):
MANAGPT_API_BASE_URL=https://YOUR-INFERENCE-HOST/v1
MANAGPT_API_KEY=
# Cloudflare Workers use MANAGPT_INFERENCE_BASE_URL and
# MANAGPT_INFERENCE_API_KEY instead; set these in Cloudflare settings.

# Workers: MANAGPT_INFERENCE_BASE_URL + MANAGPT_INFERENCE_API_KEY
